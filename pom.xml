<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- witch-parent bringt Spring Boot, Vaadin, Security/OAuth2, JPA + H2 (Benutzerdaten),
         witch-auth sowie Plugin-Konfiguration und Repositories mit (siehe Repo witch-base). -->
    <parent>
        <groupId>de.witchcafe</groupId>
        <artifactId>witch-parent</artifactId>
        <version>1.2.0</version>
        <relativePath/>
    </parent>

    <artifactId>knownet-vaadin</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>Knownet</name>
    <description>Wissensnetz: Quellen, Aussagen und typisierte Verknuepfungen in Neo4j</description>

    <dependencies>
        <!-- Gemeinsames Layout, Menue, OAuth-Provider-Status -->
        <dependency>
            <groupId>de.witchcafe</groupId>
            <artifactId>witch-ui</artifactId>
        </dependency>

        <!-- Neo4j (Graph-Daten) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-neo4j</artifactId>
        </dependency>

        <!-- API-Doku: OpenAPI-Beschreibung aus den REST-Controllern unter /api/docs/openapi.json
             (3.x = Spring Boot 4; nur JSON, ohne Swagger-UI) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
            <version>3.1.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <!-- Noetig, damit Maven witch-parent selbst findet (Token in ~/.m2/settings.xml, server-id "github") -->
    <repositories>
        <repository>
            <id>github</id>
            <name>GitHub FrankS68 Maven Packages</name>
            <url>https://maven.pkg.github.com/FrankS68/witch-auth</url>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>
</project>
