# Neo4j Datenbank
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_password_here

# GitHub OAuth (für witch-auth Login)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# GitHub Token für Maven Build (witch-auth Dependency)
# NICHT ins Repository! Nur lokal oder in CI/CD Secrets verwenden
GITHUB_TOKEN=your_github_token_here

