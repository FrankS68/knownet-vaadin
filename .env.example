# Nach .env kopieren (nicht einchecken, chmod 600), siehe DEPLOYMENT.md.

# Name des Compose-Projekts = Praefix der Volumes; bei bestehender Installation beibehalten
COMPOSE_PROJECT_NAME=knownet

# Neo4j Datenbank
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_password_here

# GitHub OAuth (für witch-auth Login)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Erster Login mit dieser E-Mail wird Admin
WITCH_AUTH_FIRST_ADMIN_EMAIL=

# Das GitHub-Token fuer den Build (read:packages) gehoert NICHT hierher,
# sondern in die Datei .github_token im Projektordner (BuildKit-Secret).
